<UserControl x:Class="OptimaBrowser.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <!-- decorative liquid blobs -->
        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-200,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E35E2D0" Offset="0" />
                    <GradientStop Color="#0035E2D0" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="90" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-240">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#348B7CFF" Offset="0" />
                    <GradientStop Color="#008B7CFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="100" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Досягнення: лічильник (клік — панель у головному вікні) -->
        <Border x:Name="AchePill" Style="{StaticResource GlassPanel}" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,18,26,0" Padding="12,7" Cursor="Hand"
                MouseLeftButtonUp="AchePill_Click" ToolTip="Мої досягнення — відкрити">
            <TextBlock x:Name="AchePillText" Text="🏆 Досягнень: 0/0"
                       FontSize="11.5" Foreground="{StaticResource BrushTextHi}" />
        </Border>

        <StackPanel MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">

            <!-- Brand -->
            <Grid HorizontalAlignment="Center" MouseLeftButtonDown="NtpLogo_Click" Cursor="Hand">
                <Border Width="70" Height="70" CornerRadius="20" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="12" Direction="270" Opacity="0.5" Color="#0A2B2A" />
                    </Border.Effect>
                    <Image Source="pack://application:,,,/OptimaBrowser;component/Assets/png/icon256.png"
                           Width="64" Height="64" Stretch="Uniform" IsHitTestVisible="False" />
                </Border>
            </Grid>

            <TextBlock x:Name="NtpClock" Text="--:--" FontSize="46" FontWeight="Light"
                       Foreground="{StaticResource BrushTextHi}" HorizontalAlignment="Center"
                       Margin="0,20,0,0" />
            <TextBlock x:Name="NtpDate" Text="" FontSize="13.5"
                       Foreground="{StaticResource BrushTextMid}" HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="NtpGreeting" Text="" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
            <TextBlock x:Name="NtpTip" Text="" FontSize="11.5"
                       Foreground="{StaticResource BrushTextLow}" HorizontalAlignment="Center"
                       Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="640" />

            <!-- Search -->
            <Border Style="{StaticResource GlassPanel}" Height="52" Margin="0,30,0,0"
                    Background="{StaticResource BrushGlassStrong}">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="EngineMark" Width="17" Height="17" Stretch="Uniform"
                           Cursor="Hand" ToolTip="Пошуковик — клік щоб змінити"
                           MouseLeftButtonUp="EngineMark_Click" VerticalAlignment="Center" />
                    <TextBox x:Name="NtpSearch" Grid.Column="1" Style="{StaticResource AddressBox}"
                             FontSize="14" Margin="10,0" VerticalAlignment="Center"
                             KeyDown="NtpSearch_KeyDown" />
                    <TextBlock Grid.Column="2" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource BrushTextLow}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Пошуковики: рядок швидкого перемикання -->
            <WrapPanel x:Name="EnginesRow" HorizontalAlignment="Center" Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <TextBlock Text="Швидкі посилання" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextMid}" Margin="4,26,0,8" />
            <UniformGrid x:Name="QuickGrid" Columns="4" Margin="0,0,0,8" />

            <TextBlock x:Name="RecentLabel" Text="Нещодавні" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextMid}" Margin="4,16,0,8" Visibility="Collapsed" />
            <WrapPanel x:Name="RecentRow" MaxWidth="680" HorizontalAlignment="Center" Margin="0,0,0,4" />

            <TextBlock Text="Optima Browser · жорстка оптимізація · рідке скло · один рушій на всі вкладки"
                       FontSize="11" Foreground="{StaticResource BrushTextLow}"
                       HorizontalAlignment="Center" Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</UserControl>